{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "pepper-prompt-engineer",
  "version": "2.5.1",
  "description": "CRAFT+ workflow for turning task descriptions into verified production-ready prompts.",
  "author": {
    "name": "ITSalt",
    "email": "info@itsalt.ru",
    "url": "https://github.com/ITSalt/PepperSkills"
  },
  "homepage": "https://github.com/ITSalt/PepperSkills/tree/main/plugins/pepper-prompt-engineer",
  "repository": "https://github.com/ITSalt/PepperSkills",
  "license": "MIT",
  "keywords": [
    "prompt-engineering",
    "craft",
    "workflow",
    "verification"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Prompt Engineer",
        "shortDescription": "CRAFT+ prompt builder",
        "longDescription": "Turns an unstructured task into a production-ready prompt with model-specific formatting, constraints and acceptance checks.",
        "category": "Productivity",
        "developerName": "ITSalt",
        "capabilities": [
          "Generate"
        ],
        "defaultPrompt": [
          "Build a verified prompt for this task."
        ]
      }
    }
  }
}
